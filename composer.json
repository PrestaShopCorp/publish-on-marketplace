{
    "name": "prestashop/publish-on-marketplace",
    "description": "Publish extensions on the PrestaShop Marketplace",
    "config": {
        "preferred-install": "dist",
        "prepend-autoloader": false,
        "optimize-autoloader": true
    },
    "bin": ["bin/publish-on-marketplace"],
    "autoload": {
        "psr-4": {
            "PrestaShop\\Marketplace\\": "src/"
        }
    },
    "author": "PrestaShop",
    "license": "MIT",
    "require": {
        "php": "^7.4|^8.0",
        "symfony/console": "^5.4",
        "guzzlehttp/guzzle": "^7.10"
    },
    "require-dev": {
        "prestashop/php-dev-tools": "^5.0",
        "phpstan/phpstan": "^2.1",
        "friendsofphp/php-cs-fixer": "^3.95"
    }
}
